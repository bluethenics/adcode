orules_version = '2';

// Every path is closed to clients.
//
// Spec §7: identity comes from a verified bearer token and money is computed server-side,
// so nothing in this database is ever written by a client directly - `services/api` uses
// the Admin SDK, which bypasses these rules entirely. A permissive rule here would be a
// second, weaker way into the ledger, so there isn't one.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
