{
  "id": "/phone/",
  "name": "ADCode Remote",
  "short_name": "ADCode",
  "description": "Chat with ADCode on your own computer from your phone.",
  "start_url": "/phone/?source=pwa",
  "scope": "/phone/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#111110",
