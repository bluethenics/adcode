# The website's build-time settings.
#
# Copy this file to `.env.production` and fill in the two blanks. `.env.production` is
# gitignored; this example is not.
#
#     cp apps/web/.env.example apps/web/.env.production
#
# **Why a file and not a Cloudflare secret.** Everything here is a `NEXT_PUBLIC_` value,
# and Next replaces those with literals when it builds - they are baked into the JavaScript
# the browser downloads, so they have to exist at build time. A Cloudflare secret is a
# runtime value and would arrive far too late.
#
# **All of it is public**, and that is fine. A Firebase web API key identifies a project; it
# does not authorise anything. What protects the data is token verification in
# `services/api` and a database with row level security on and no policies. The keys that
# would matter - the Supabase service_role key, payout encryption key, and Dodo keys - are never in this file and
# never reach the browser. They are Cloudflare secrets. See SETUP.md step 8.

# Where the site is served from. Change both this and the value in wrangler.jsonc together.
NEXT_PUBLIC_SITE_ORIGIN=https://adcode.bluethenics.com

# The API is part of this same deployment, at /v1/*, so it shares the origin above.
# Set this only to point the pages at an API running somewhere else, e.g. http://127.0.0.1:8788
# NEXT_PUBLIC_API_ORIGIN=

# Firebase, from console.firebase.google.com → Project settings → General → Your apps.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=adcode-idle
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=adcode-idle.firebaseapp.com

# Fill these two in. They are the `apiKey` and `appId` from the same page.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_APP_ID=

# owner/repo that installers and the auto-updater fetch releases from.
NEXT_PUBLIC_GITHUB_REPO=adcode/adcode
