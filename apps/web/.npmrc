# Imprezia's SDK is published to GitHub Packages. The token comes from the environment
# (ADCODE_PKG_TOKEN, Imprezia dashboard > API Keys > Web & Android SDK Access Token) and is
# never written here. Every other package still comes from the public registry. Not
# `GITHUB_*`: GitHub Actions reserves that prefix for secrets, so a repository secret of
# that name cannot exist.
@adimpress:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${ADCODE_PKG_TOKEN}
