{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023"
    ],
    "types": [
      "../cloud/node_modules/@cloudflare/workers-types"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@adcode/settings": [
        "../../packages/settings/src/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "worker-configuration.d.ts"
  ]
}
