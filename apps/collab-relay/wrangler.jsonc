{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "adcode-collab",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [{ "pattern": "collab.bluethenics.com", "custom_domain": true }],
  "observability": { "enabled": true },
  "vars": { "FIREBASE_PROJECT_ID": "adcode-idle" },
  "services": [{ "binding": "ACCOUNT_API", "service": "adcode" }],
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "CollabRoom" }, { "name": "PROJECTS", "class_name": "CloudProject" }, { "name": "PROJECT_ACCOUNTS", "class_name": "ProjectAccount" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CollabRoom"] }, { "tag": "v2", "new_sqlite_classes": ["CloudProject", "ProjectAccount"] }]
}
