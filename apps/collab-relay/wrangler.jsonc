{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "adcode-projects",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [{ "pattern": "projects.bluethenics.com", "custom_domain": true }],
  "observability": { "enabled": true },
  "vars": { "FIREBASE_PROJECT_ID": "adcode-idle" },
  "services": [{ "binding": "ENTITLEMENTS", "service": "adcode", "entrypoint": "ProjectEntitlements" }],
  "durable_objects": { "bindings": [
    { "name": "ROOMS", "class_name": "CollabRoom" },
    { "name": "PROJECT_ACCOUNTS", "class_name": "ProjectDirectory" },
    { "name": "SHARED_PROJECTS", "class_name": "SharedProject" },
    { "name": "REQUEST_QUEUES", "class_name": "PriorityQueue" },
    { "name": "COMMUNITY", "class_name": "CommunityHub" },
    { "name": "ARTIFACT_VAULTS", "class_name": "ArtifactVault" },
    { "name": "ARTIFACT_ROOMS", "class_name": "ArtifactRoom" },
    { "name": "PHONE_LINKS", "class_name": "PhoneLink" }
  ] },
  // Local packages resolve by alias here too (no npm workspaces on FAT32): the community
  // rules import the settings schema to decide which settings a plugin may preset.
  "alias": { "@adcode/settings": "../../packages/settings/src/index.ts" },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CollabRoom", "ProjectDirectory", "SharedProject", "PriorityQueue"] },
    { "tag": "v2", "new_sqlite_classes": ["CommunityHub", "ArtifactVault"] },
    { "tag": "v3", "new_sqlite_classes": ["ArtifactRoom"] },
    { "tag": "v4", "new_sqlite_classes": ["PhoneLink"] }
  ]
}
